# Operator-side secrets for this monorepo. Copy to .env (gitignored) and fill in.
# Keys belong to the operator, never to a package or a commit.

# web-search-mcp (mcps/orquestra-web-search): Exa web search
# Copied to .env and filled in here, the MCP server finds it on its own: no
# export needed. Point WEB_SEARCH_ENV_FILE at another file to override that.
EXA_API_KEY=
